# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional override for the admin password (if not set, server verifies against its salted scrypt hash).
# Configure real secrets only via the AI Studio Secrets panel, never commit real values.
ADMIN_PASSWORD=""

# Optional Supabase Cloud PostgreSQL + Storage configuration.
# When configured, products and uploaded images persist in Supabase Cloud across all devices and deployments.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
